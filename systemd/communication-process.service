[Unit]
Description=Raspberry Pi 4B Edge IoT Communication Process
Wants=network-online.target
After=network-online.target

[Service]
Type=simple

User=edgeiot
Group=edgeiot

EnvironmentFile=/etc/raspberry-pi-edge-iot/communication.env

ExecStart=/usr/local/bin/communication-process

Restart=on-failure
RestartSec=5s

TimeoutStopSec=15s

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target