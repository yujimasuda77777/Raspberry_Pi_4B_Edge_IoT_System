[Unit]
Description=Raspberry Pi 4B Edge IoT Sensor Process
After=local-fs.target

[Service]
Type=simple

User=edgeiot
Group=edgeiot
SupplementaryGroups=gpio

ExecStart=/usr/local/bin/sensor-process

Restart=on-failure
RestartSec=5s

TimeoutStopSec=10s

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target